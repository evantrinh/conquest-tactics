.hp-bar {
    flex-direction: row;
    align-items: center;
}

.hp-bar__track {
    flex-grow: 1;
    height: 12px;
    background-color: var(--c-track);
}

.hp-bar__fill {
    height: 100%;
    background-color: var(--c-fill);
}

.hp-bar__text {
    width: 64px;
    margin-left: 8px;
    color: var(--c-text);
    -unity-text-align: middle-right;
}
