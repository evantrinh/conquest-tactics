.fan {
    position: absolute;
    width: 0;
    height: 0;
}

.fan__button {
    position: absolute;
    width: 44px;
    height: 44px;
    border-radius: 22px;
    margin: 0;
}

.fan__skill {
    left: 26px;
    top: -92px;
}

.fan__wait {
    left: 78px;
    top: -44px;
}

.fan__close {
    left: -42px;
    top: -74px;
    width: 28px;
    height: 28px;
    border-radius: 14px;
}

.fan .fan__cost {
    position: absolute;
    left: 22px;
    top: -44px;
    width: 52px;
    -unity-text-align: middle-center;
    font-size: 11px;
    color: var(--c-ready);
}
