.battle-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.battle-root .unity-label {
    color: var(--c-text);
}

.top-bar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    flex-direction: row;
    padding: 12px;
    background-color: var(--c-panel);
}

.top-bar__side {
    flex-grow: 1;
    flex-basis: 0;
}

.top-bar__side--right {
    align-items: flex-end;
}

.top-bar__center {
    align-items: center;
}

.top-bar__title {
    font-size: 16px;
    -unity-font-style: bold;
}

.battle-root .top-bar__subtitle {
    color: var(--c-muted);
    font-size: 12px;
}

.top-bar__center .pips {
    margin-top: 6px;
    margin-bottom: 6px;
}

.top-bar__button {
    width: 80px;
}

.banner {
    position: absolute;
    left: 0;
    right: 0;
    top: 140px;
    font-size: 32px;
    -unity-text-align: middle-center;
    display: none;
}

.banner--shown {
    display: flex;
}

.roster {
    position: absolute;
    left: 16px;
    bottom: 16px;
    flex-direction: row;
}

.end-turn {
    position: absolute;
    right: 16px;
    bottom: 16px;
    width: 108px;
    height: 40px;
}
